{
  "name": "multichatstream",
  "version": "1.0.0",
  "description": "Multi-Platform Live Stream Chat Overlay & Aggregator (YouTube, Twitch, TikTok, Discord)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:portable": "npx electron-builder --win portable",
    "build:installer": "npx electron-builder --win nsis",
    "build:all": "npx electron-builder --win portable nsis"
  },
  "keywords": [
    "multichatstream",
    "livechat",
    "stream-overlay",
    "youtube",
    "twitch",
    "tiktok",
    "discord"
  ],
  "author": "MultiChatStream",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.multichatstream.app",
    "productName": "MultiChatStream",
    "copyright": "Copyright © 2026 MultiChatStream",
    "directories": {
      "output": "build-output"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "main.js",
      "donation.html",
      "donation.js",
      "favicon.ico",
      "kaget.png",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "favicon.ico",
      "target": [
        "portable",
        "nsis"
      ],
      "sign": "scripts/sign.js"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "favicon.ico",
      "uninstallerIcon": "favicon.ico",
      "artifactName": "multichatstream-installer.exe"
    },
    "portable": {
      "artifactName": "multichatstream-portable.exe"
    }
  },
  "dependencies": {
    "tiktok-live-connector": "^2.5.0"
  }
}
